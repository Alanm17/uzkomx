",title:"Action & War",titleLatn:"Jangovar va harbiy",titleCyrl:"\u0416\u0430\u043d\u0433\u043e\u0432\u0430\u0440 \u0432\u0430 \u04b3\u0430\u0440\u0431\u0438\u0439",imageKey:"comics/samarqand-komiks-1/ep01/006.png"},{id:"completed",title:"Completed",titleLatn:"Tugallangan",titleCyrl:"\u0422\u0443\u0433\u0430\u043b\u043b\u0430\u043d\u0433\u0430\u043d",imageKey:"comics/samarqand/ep01/007.png"}],c=[{id:"historical",en:"Historical",uzLatn:"Tarixiy",uzCyrl:"\u0422\u0430\u0440\u0438\u0445\u0438\u0439"},{id:"action",en:"Action & War",uzLatn:"Jangovar",uzCyrl:"\u0416\u0430\u043d\u0433\u043e\u0432\u0430\u0440"},{id:"biography",en:"Biography",uzLatn:"Buyuk shaxslar",uzCyrl:"\u0411\u0443\u044e\u043a \u0448\u0430\u0445\u0441\u043b\u0430\u0440"},{id:"empire",en:"Empires & Dynasties",uzLatn:"Saltanatlar",uzCyrl:"\u0421\u0430\u043b\u0442\u0430\u043d\u0430\u0442\u043b\u0430\u0440"},{id:"silkroad",en:"Silk Road",uzLatn:"Buyuk Ipak Yo\u02bbli",uzCyrl:"\u0411\u0443\u044e\u043a \u0418\u043f\u0430\u043a \u0419\u045e\u043b\u0438"},{id:"adventure",en:"Adventure",uzLatn:"Sarguzasht",uzCyrl:"\u0421\u0430\u0440\u0433\u0443\u0437\u0430\u0448\u0442"},{id:"drama",en:"Drama",uzLatn:"Drama",uzCyrl:"\u0414\u0440\u0430\u043c\u0430"},{id:"science",en:"Science & Renaissance",uzLatn:"Ilm-fan va Renessans",uzCyrl:"\u0418\u043b\u043c-\u0444\u0430\u043d \u0432\u0430 \u0420\u0435\u043d\u0435\u0441\u0441\u0430\u043d\u0441"},{id:"legend",en:"Legends & Epics",uzLatn:"Afsonalar",uzCyrl:"\u0410\u0444\u0441\u043e\u043d\u0430\u043b\u0430\u0440"},{id:"mystery",en:"Ancient Mysteries",uzLatn:"Qadimiy sirlar",uzCyrl:"\u049a\u0430\u0434\u0438\u043c\u0438\u0439 \u0441\u0438\u0440\u043b\u0430\u0440"}]},1083,[]);
