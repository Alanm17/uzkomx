__d(function(a,i,s,o,n,r,m){n.exports={id:"samarqand-komiks-1-01",seriesId:"samarqand-komiks-1",episodeNumber:1,title:{"uz-Latn":"Samarqand Komiks (1) (1-qism)","uz-Cyrl":"\u0421\u0430\u043c\u0430\u0440\u049b\u0430\u043d\u0434 \u041a\u043e\u043c\u0438\u043a\u0441 (1) (1-\u049b\u0438\u0441\u043c)"},estimatedReadingMinutes:6,panels:[{id:"samarqand-komiks-1-01-001",image:"comics/samarqand-komiks-1/ep01/001.png",aspectRatio:.7063},{id:"samarqand-komiks-1-01-002",image:"comics/samarqand-komiks-1/ep01/002.png",aspectRatio:.7063,narration:{"uz-Latn":"\ud83d\udcdc Sarbadarlar kim edi?\n\nSarbadarlar XIV asrda turli hududlarda faoliyat yuritgan siyosiy-ijtimoiy harakat vakillari edi. Samarqandda Mavlonozoda, Abu Bakr Kalaviy va Xurdak Buxoriy shahar mudofaasiga boshchilik qilgan.","uz-Cyrl":"\ud83d\udcdc \u0421\u0430\u0440\u0431\u0430\u0434\u0430\u0440\u043b\u0430\u0440 \u043a\u0438\u043c \u044d\u0434\u0438?\n\n\u0421\u0430\u0440\u0431\u0430\u0434\u0430\u0440\u043b\u0430\u0440 XIV \u0430\u0441\u0440\u0434\u0430 \u0442\u0443\u0440\u043b\u0438 \u04b3\u0443\u0434\u0443\u0434\u043b\u0430\u0440\u0434\u0430 \u0444\u0430\u043e\u043b\u0438\u044f\u0442 \u044e\u0440\u0438\u0442\u0433\u0430\u043d \u0441\u0438\u0451\u0441\u0438\u0439-\u0438\u0436\u0442\u0438\u043c\u043e\u0438\u0439 \u04b3\u0430\u0440\u0430\u043a\u0430\u0442 \u0432\u0430\u043a\u0438\u043b\u043b\u0430\u0440\u0438 \u044d\u0434\u0438. \u0421\u0430\u043c\u0430\u0440\u049b\u0430\u043d\u0434\u0434\u0430 \u041c\u0430\u0432\u043b\u043e\u043d\u043e\u0437\u043e\u0434\u0430, \u0410\u0431\u0443 \u0411\u0430\u043a\u0440 \u041a\u0430\u043b\u0430\u0432\u0438\u0439 \u0432\u0430 \u0425\u0443\u0440\u0434\u0430\u043a \u0411\u0443\u0445\u043e\u0440\u0438\u0439 \u0448\u0430\u04b3\u0430\u0440 \u043c\u0443\u0434\u043e\u0444\u0430\u0430\u0441\u0438\u0433\u0430 \u0431\u043e\u0448\u0447\u0438\u043b\u0438\u043a \u049b\u0438\u043b\u0433\u0430\u043d."},textStyle:{backgroundColor:"#12263F",textColor:"#FFFFFF",fontStyle:"sans",fontSize:"md"}},{id:"samarqand-komiks-1-01-003",image:"comics/samarqand-komiks-1/ep01/003.png",aspectRatio:.7063,narration:{"uz-Latn":"\ud83d\udcdc Nega otlar kasalligi muhim edi?\n\nO\u2018rta asrlarda otlar qo\u2018shin uchun asosiy transport va harbiy vositalardan biri edi. Otlar orasida kasallik tarqalishi qo\u2018shinning harakatlanishi va jangovar imkoniyatlarini jiddiy zaiflashtirishi mumkin edi.","uz-Cyrl":"\ud83d\udcdc \u041d\u0435\u0433\u0430 \u043e\u0442\u043b\u0430\u0440 \u043a\u0430\u0441\u0430\u043b\u043b\u0438\u0433\u0438 \u043c\u0443\u04b3\u0438\u043c \u044d\u0434\u0438?\n\n\u040e\u0440\u0442\u0430 \u0430\u0441\u0440\u043b\u0430\u0440\u0434\u0430 \u043e\u0442\u043b\u0430\u0440 \u049b\u045e\u0448\u0438\u043d \u0443\u0447\u0443\u043d \u0430\u0441\u043e\u0441\u0438\u0439 \u0442\u0440\u0430\u043d\u0441\u043f\u043e\u0440\u0442 \u0432\u0430 \u04b3\u0430\u0440\u0431\u0438\u0439 \u0432\u043e\u0441\u0438\u0442\u0430\u043b\u0430\u0440\u0434\u0430\u043d \u0431\u0438\u0440\u0438 \u044d\u0434\u0438. \u041e\u0442\u043b\u0430\u0440 \u043e\u0440\u0430\u0441\u0438\u0434\u0430 \u043a\u0430\u0441\u0430\u043b\u043b\u0438\u043a \u0442\u0430\u0440\u049b\u0430\u043b\u0438\u0448\u0438 \u049b\u045e\u0448\u0438\u043d\u043d\u0438\u043d\u0433 \u04b3\u0430\u0440\u0430\u043a\u0430\u0442\u043b\u0430\u043d\u0438\u0448\u0438 \u0432\u0430 \u0436\u0430\u043d\u0433\u043e\u0432\u0430\u0440 \u0438\u043c\u043a\u043e\u043d\u0438\u044f\u0442\u043b\u0430\u0440\u0438\u043d\u0438 \u0436\u0438\u0434\u0434\u0438\u0439 \u0437\u0430\u0438\u0444\u043b\u0430\u0448\u0442\u0438\u0440\u0438\u0448\u0438 \u043c\u0443\u043c\u043a\u0438\u043d \u044d\u0434\u0438."},textStyle:{backgroundColor:"#12263F",textColor:"#FFFFFF",fontStyle:"sans",fontSize:"md"}},{id:"samarqand-komiks-1-01-004",image:"comics/samarqand-komiks-1/ep01/004.png",aspectRatio:.7063},{id:"samarqand-komiks-1-01-005",image:"comics/samarqand-komiks-1/ep01/005.png",aspectRatio:.7063},{id:"samarqand-komiks-1-01-006",image:"comics/samarqand-komiks-1/ep01/006.png",aspectRatio:.7063},{id:"samarqand-komiks-1-01-007",image:"comics/samarqand-komiks-1/ep01/007.png",aspectRatio:.7063},{id:"samarqand-komiks-1-01-008",image:"comics/samarqand-komiks-1/ep01/008.png",aspectRatio:.7063}]}},990,[]);
__d(function(a,i,r,t,o,n,l){o.exports={id:"temur-01",seriesId:"temur",episodeNumber:1,title:{"uz-Latn":"Yoshlik yillari","uz-Cyrl":"\u0401\u0448\u043b\u0438\u043a \u0439\u0438\u043b\u043b\u0430\u0440\u0438"},estimatedReadingMinutes:4,panels:[{id:"temur-01-001",image:"comics/temur/ep01/001.webp",narration:{"uz-Latn":"1336-yil. Kesh yaqinidagi Xo\u02bbja Ilg\u02bbor qishlog\u02bbi. Zarafshon tog\u02bblari etagidagi bu yam-yashil voha Barlos beklari xonadoniga beshik bo\u02bbldi.","uz-Cyrl":"1336-\u0439\u0438\u043b. \u041a\u0435\u0448 \u044f\u049b\u0438\u043d\u0438\u0434\u0430\u0433\u0438 \u0425\u045e\u0436\u0430 \u0418\u043b\u0493\u043e\u0440 \u049b\u0438\u0448\u043b\u043e\u0493\u0438. \u0417\u0430\u0440\u0430\u0444\u0448\u043e\u043d \u0442\u043e\u0493\u043b\u0430\u0440\u0438 \u044d\u0442\u0430\u0433\u0438\u0434\u0430\u0433\u0438 \u0431\u0443 \u044f\u043c-\u044f\u0448\u0438\u043b \u0432\u043e\u04b3\u0430 \u0411\u0430\u0440\u043b\u043e\u0441 \u0431\u0435\u043a\u043b\u0430\u0440\u0438 \u0445\u043e\u043d\u0430\u0434\u043e\u043d\u0438\u0433\u0430 \u0431\u0435\u0448\u0438\u043a \u0431\u045e\u043b\u0434\u0438."},altText:{"uz-Latn":"Zarafshon tog\u02bblari etagidagi XIV asr qishloq manzarasi","uz-Cyrl":"\u0417\u0430\u0440\u0430\u0444\u0448\u043e\u043d \u0442\u043e\u0493\u043b\u0430\u0440\u0438 \u044d\u0442\u0430\u0433\u0438\u0434\u0430\u0433\u0438 XIV \u0430\u0441\u0440 \u049b\u0438\u0448\u043b\u043e\u049b \u043c\u0430\u043d\u0437\u0430\u0440\u0430\u0441\u0438"}},{id:"temur-01-002",image:"comics/temur/ep01/002.webp",narration:{"uz-Latn":"Amir Tarag\u02bbay bahodir xonadonida tug\u02bbilgan yosh Temur bolaligidanoq tengqurlaridan ziyrakligi va qat\u02bciyati bilan ajralib turardi.","uz-Cyrl":"\u0410\u043c\u0438\u0440 \u0422\u0430\u0440\u0430\u0493\u0430\u0439 \u0431\u0430\u04b3\u043e\u0434\u0438\u0440 \u0445\u043e\u043d\u0430\u0434\u043e\u043d\u0438\u0434\u0430 \u0442\u0443\u0493\u0438\u043b\u0433\u0430\u043d \u0451\u0448 \u0422\u0435\u043c\u0443\u0440 \u0431\u043e\u043b\u0430\u043b\u0438\u0433\u0438\u0434\u0430\u043d\u043e\u049b \u0442\u0435\u043d\u0433\u049b\u0443\u0440\u043b\u0430\u0440\u0438\u0434\u0430\u043d \u0437\u0438\u0439\u0440\u0430\u043a\u043b\u0438\u0433\u0438 \u0432\u0430 \u049b\u0430\u0442\u044a\u0438\u044f\u0442\u0438 \u0431\u0438\u043b\u0430\u043d \u0430\u0436\u0440\u0430\u043b\u0438\u0431 \u0442\u0443\u0440\u0430\u0440\u0434\u0438."},dialogue:{"uz-Latn":"\xabHaqiqiy mardlik \u2014 qiyinchilik oldida chekinmaslikdir.\xbb","uz-Cyrl":"\xab\u04b2\u0430\u049b\u0438\u049b\u0438\u0439 \u043c\u0430\u0440\u0434\u043b\u0438\u043a \u2014 \u049b\u0438\u0439\u0438\u043d\u0447\u0438\u043b\u0438\u043a \u043e\u043b\u0434\u0438\u0434\u0430 \u0447\u0435\u043a\u0438\u043d\u043c\u0430\u0441\u043b\u0438\u043a\u0434\u0438\u0440.\xbb"},altText:{"uz-Latn":"Yosh Temur hovlida oti yonida o\u02bbychan turibdi","uz-Cyrl":"\u0401\u0448 \u0422\u0435\u043c\u0443\u0440 \u04b3\u043e\u0432\u043b\u0438\u0434\u0430 \u043e\u0442\u0438 \u0451\u043d\u0438\u0434\u0430 \u045e\u0439\u0447\u0430\u043d \u0442\u0443\u0440\u0438\u0431\u0434\u0438"}},{id:"temur-01-003",image:"comics/temur/ep01/003.webp",narration:{"uz-Latn":"U erta tongdan quyosh botguncha ot choptirish, qilichbozlik va kamondan o\u02bbq uzish mashqlarini muttasil bajardi.","uz-Cyrl":"\u0423 \u044d\u0440\u0442\u0430 \u0442\u043e\u043d\u0433\u0434\u0430\u043d \u049b\u0443\u0451\u0448 \u0431\u043e\u0442\u0433\u0443\u043d\u0447\u0430 \u043e\u0442 \u0447\u043e\u043f\u0442\u0438\u0440\u0438\u0448, \u049b\u0438\u043b\u0438\u0447\u0431\u043e\u0437\u043b\u0438\u043a \u0432\u0430 \u043a\u0430\u043c\u043e\u043d\u0434\u0430\u043d \u045e\u049b \u0443\u0437\u0438\u0448 \u043c\u0430\u0448\u049b\u043b\u0430\u0440\u0438\u043d\u0438 \u043c\u0443\u0442\u0442\u0430\u0441\u0438\u043b \u0431\u0430\u0436\u0430\u0440\u0434\u0438."},dialogue:{"uz-Latn":"Nishon har qancha uzoq bo\u02bblmasin, ko\u02bbz va qo\u02bbl bir bo\u02bblsa, o\u02bbq adashmaydi!","uz-Cyrl":"\u041d\u0438\u0448\u043e\u043d \u04b3\u0430\u0440 \u049b\u0430\u043d\u0447\u0430 \u0443\u0437\u043e\u049b \u0431\u045e\u043b\u043c\u0430\u0441\u0438\u043d, \u043a\u045e\u0437 \u0432\u0430 \u049b\u045e\u043b \u0431\u0438\u0440 \u0431\u045e\u043b\u0441\u0430, \u045e\u049b \u0430\u0434\u0430\u0448\u043c\u0430\u0439\u0434\u0438!"},altText:{"uz-Latn":"Yosh jangchi chopib ketayotgan ot ustida kamon tortmoqda","uz-Cyrl":"\u0401\u0448 \u0436\u0430\u043d\u0433\u0447\u0438 \u0447\u043e\u043f\u0438\u0431 \u043a\u0435\u0442\u0430\u0451\u0442\u0433\u0430\u043d \u043e\u0442 \u0443\u0441\u0442\u0438\u0434\u0430 \u043a\u0430\u043c\u043e\u043d \u0442\u043e\u0440\u0442\u043c\u043e\u049b\u0434\u0430"}},{id:"temur-01-004",image:"comics/temur/ep01/004.webp",narration:{"uz-Latn":"Biroq u faqat qurol bilan kifoyalanmadi. Davrning buyuk ulamolaridan hisob, tarix, Qur\u02bcon va she\u02bcriyat saboqlarini oldi.","uz-Cyrl":"\u0411\u0438\u0440\u043e\u049b \u0443 \u0444\u0430\u049b\u0430\u0442 \u049b\u0443\u0440\u043e\u043b \u0431\u0438\u043b\u0430\u043d \u043a\u0438\u0444\u043e\u044f\u043b\u0430\u043d\u043c\u0430\u0434\u0438. \u0414\u0430\u0432\u0440\u043d\u0438\u043d\u0433 \u0431\u0443\u044e\u043a \u0443\u043b\u0430\u043c\u043e\u043b\u0430\u0440\u0438\u0434\u0430\u043d \u04b3\u0438\u0441\u043e\u0431, \u0442\u0430\u0440\u0438\u0445, \u049a\u0443\u0440\u044a\u043e\u043d \u0432\u0430 \u0448\u0435\u044a\u0440\u0438\u044f\u0442 \u0441\u0430\u0431\u043e\u049b\u043b\u0430\u0440\u0438\u043d\u0438 \u043e\u043b\u0434\u0438."},dialogue:{"uz-Latn":"\xabQilich bilan fath etilgan yurt faqat adolat va ilm bilan boshqariladi.\xbb","uz-Cyrl":"\xab\u049a\u0438\u043b\u0438\u0447 \u0431\u0438\u043b\u0430\u043d \u0444\u0430\u0442\u04b3 \u044d\u0442\u0438\u043b\u0433\u0430\u043d \u044e\u0440\u0442 \u0444\u0430\u049b\u0430\u0442 \u0430\u0434\u043e\u043b\u0430\u0442 \u0432\u0430 \u0438\u043b\u043c \u0431\u0438\u043b\u0430\u043d \u0431\u043e\u0448\u049b\u0430\u0440\u0438\u043b\u0430\u0434\u0438.\xbb"},altText:{"uz-Latn":"Yosh Temur oq sallali donishmand ustoz sabog\u02bbini tinglamoqda","uz-Cyrl":"\u0401\u0448 \u0422\u0435\u043c\u0443\u0440 \u043e\u049b \u0441\u0430\u043b\u043b\u0430\u043b\u0438 \u0434\u043e\u043d\u0438\u0448\u043c\u0430\u043d\u0434 \u0443\u0441\u0442\u043e\u0437 \u0441\u0430\u0431\u043e\u0493\u0438\u043d\u0438 \u0442\u0438\u043d\u0433\u043b\u0430\u043c\u043e\u049b\u0434\u0430"}},{id:"temur-01-005",image:"comics/temur/ep01/005.webp",narration:{"uz-Latn":"Movarounnahr parchalangan va ziddiyatlarga to\u02bbla edi. Yosh bahodir o\u02bbz xalqini birlashtirish va qudratli, adolatli saltanat barpo etish ahdini qildi.","uz-Cyrl":"\u041c\u043e\u0432\u0430\u0440\u043e\u0443\u043d\u043d\u0430\u04b3\u0440 \u043f\u0430\u0440\u0447\u0430\u043b\u0430\u043d\u0433\u0430\u043d \u0432\u0430 \u0437\u0438\u0434\u0434\u0438\u044f\u0442\u043b\u0430\u0440\u0433\u0430 \u0442\u045e\u043b\u0430 \u044d\u0434\u0438. \u0401\u0448 \u0431\u0430\u04b3\u043e\u0434\u0438\u0440 \u045e\u0437 \u0445\u0430\u043b\u049b\u0438\u043d\u0438 \u0431\u0438\u0440\u043b\u0430\u0448\u0442\u0438\u0440\u0438\u0448 \u0432\u0430 \u049b\u0443\u0434\u0440\u0430\u0442\u043b\u0438, \u0430\u0434\u043e\u043b\u0430\u0442\u043b\u0438 \u0441\u0430\u043b\u0442\u0430\u043d\u0430\u0442 \u0431\u0430\u0440\u043f\u043e \u044d\u0442\u0438\u0448 \u0430\u04b3\u0434\u0438\u043d\u0438 \u049b\u0438\u043b\u0434\u0438."},altText:{"uz-Latn":"Samarqand ufqiga qat\u02bciyat bilan boqayotgan Temur","uz-Cyrl":"\u0421\u0430\u043c\u0430\u0440\u049b\u0430\u043d\u0434 \u0443\u0444\u049b\u0438\u0433\u0430 \u049b\u0430\u0442\u044a\u0438\u044f\u0442 \u0431\u0438\u043b\u0430\u043d \u0431\u043e\u049b\u0430\u0451\u0442\u0433\u0430\u043d \u0422\u0435\u043c\u0443\u0440"}}],notes:[{panelId:"temur-01-001",text:{"uz-Latn":"Amir Temurning tavallud topgan joyi va yili haqida Nizomiddin Shomiy va Sharafiddin Ali Yazdiyning \xabZafarnoma\xbb asarlarida batafsil ma\u02bclumot berilgan.","uz-Cyrl":"\u0410\u043c\u0438\u0440 \u0422\u0435\u043c\u0443\u0440\u043d\u0438\u043d\u0433 \u0442\u0430\u0432\u0430\u043b\u043b\u0443\u0434 \u0442\u043e\u043f\u0433\u0430\u043d \u0436\u043e\u0439\u0438 \u0432\u0430 \u0439\u0438\u043b\u0438 \u04b3\u0430\u049b\u0438\u0434\u0430 \u041d\u0438\u0437\u043e\u043c\u0438\u0434\u0434\u0438\u043d \u0428\u043e\u043c\u0438\u0439 \u0432\u0430 \u0428\u0430\u0440\u0430\u0444\u0438\u0434\u0434\u0438\u043d \u0410\u043b\u0438 \u042f\u0437\u0434\u0438\u0439\u043d\u0438\u043d\u0433 \xab\u0417\u0430\u0444\u0430\u0440\u043d\u043e\u043c\u0430\xbb \u0430\u0441\u0430\u0440\u043b\u0430\u0440\u0438\u0434\u0430 \u0431\u0430\u0442\u0430\u0444\u0441\u0438\u043b \u043c\u0430\u044a\u043b\u0443\u043c\u043e\u0442 \u0431\u0435\u0440\u0438\u043b\u0433\u0430\u043d."},sources:["Nizomiddin Shomiy, \xabZafarnoma\xbb, Toshkent, 1996","Bo\u02bbriboy Ahmedov, \xabAmir Temur\xbb, 1995"]},{panelId:"temur-01-004",text:{"uz-Latn":"\xabTemur tuzuklari\xbbda qayd etilishicha, Temur yoshligidan donishmandlar majlisida bo\u02bblishni, bahslarni tinglashni yaxshi ko\u02bbrgan va qat\u02bciy qoidalarga amal qilgan.","uz-Cyrl":"\xab\u0422\u0435\u043c\u0443\u0440 \u0442\u0443\u0437\u0443\u043a\u043b\u0430\u0440\u0438\xbb\u0434\u0430 \u049b\u0430\u0439\u0434 \u044d\u0442\u0438\u043b\u0438\u0448\u0438\u0447\u0430, \u0422\u0435\u043c\u0443\u0440 \u0451\u0448\u043b\u0438\u0433\u0438\u0434\u0430\u043d \u0434\u043e\u043d\u0438\u0448\u043c\u0430\u043d\u0434\u043b\u0430\u0440 \u043c\u0430\u0436\u043b\u0438\u0441\u0438\u0434\u0430 \u0431\u045e\u043b\u0438\u0448\u043d\u0438, \u0431\u0430\u04b3\u0441\u043b\u0430\u0440\u043d\u0438 \u0442\u0438\u043d\u0433\u043b\u0430\u0448\u043d\u0438 \u044f\u0445\u0448\u0438 \u043a\u045e\u0440\u0433\u0430\u043d \u0432\u0430 \u049b\u0430\u0442\u044a\u0438\u0439 \u049b\u043e\u0438\u0434\u0430\u043b\u0430\u0440\u0433\u0430 \u0430\u043c\u0430\u043b \u049b\u0438\u043b\u0433\u0430\u043d."},sources:["\xabTemur tuzuklari\xbb, Toshkent, O\u02bbzbekiston nashriyoti, 2011"]}]}},991,[]);
